[Unit]
Description=UDAR CRM Raspberry Pi GPIO Machine Agent
# Saat: time-set.target, saatin kayitli son degerden kabaca kuruldugu andir
# (internet beklemez). time-sync.target'a BILEREK baglanmadi: o ancak
# systemd-time-wait-sync acikken bir sey bekler ve internet gelene kadar
# SURESIZ bekler; o arada ajan hic baslamaz, vuruslar sayilmaz, kuyruga bile
# yazilmaz. Ajan saati kendisi izler ve her kayda clock_synced ile
# queue_age_seconds yazar; CRM zamani bunlarla duzeltebilir (README "Saat").
After=network-online.target time-set.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/udar-pi-agent.env
ExecStart=/usr/bin/python3 /opt/udar-pi-agent/udar_pi_agent.py
Restart=always
RestartSec=3
User=root
WorkingDirectory=/opt/udar-pi-agent

[Install]
WantedBy=multi-user.target
