# CRM adresi. BILEREK BOS: kurulum sihirbazi adresi yazdirmadan gecmez.
# Ornek: https://crm.firmaniz.com
UDAR_CRM_URL=

# Create this token from CRM > İmalat Yönetimi > Cihaz & Veri.
UDAR_DEVICE_TOKEN=PASTE_DEVICE_TOKEN_HERE

# Raspberry Pi physical pin 13 is BCM GPIO27 in the current AYKA test wiring.
# If you wire physical pin 11 instead, use BCM GPIO17.
UDAR_GPIO_BCM=27
UDAR_PULL_UP=false
UDAR_BOUNCE_SECONDS=0.05
UDAR_POLL_INTERVAL_SECONDS=0.002

# pulse: every rising voltage edge is one operation.
# duration: high voltage duration is measured and sent as seconds/minutes.
UDAR_MEASUREMENT_MODE=pulse
# rising: idle 0, hit 1. falling: idle 1, hit 0. both: count every state change.
UDAR_PULSE_EDGE=rising
# A pulse is counted only after a complete inactive -> active -> inactive cycle.
UDAR_PULSE_MIN_ACTIVE_SECONDS=0.02
UDAR_PULSE_REARM_SECONDS=0.20
UDAR_PULSE_MAX_ACTIVE_SECONDS=10.0
UDAR_PULSE_MIN_INTERVAL_SECONDS=0.20
UDAR_DURATION_UNIT=seconds
UDAR_MIN_DURATION_SECONDS=0.2
UDAR_DURATION_ACTIVE_LEVEL=high
UDAR_DURATION_START_STABLE_SECONDS=0.20
UDAR_DURATION_STOP_STABLE_SECONDS=0.20
# Ignore short LOW gaps while a duration machine is running. A real stop must
# remain LOW continuously for this many seconds.
UDAR_DURATION_DROPOUT_GRACE_SECONDS=1.50
# Aggregate ignored dropout diagnostics instead of writing one log per glitch.
UDAR_DURATION_DROPOUT_LOG_INTERVAL_SECONDS=30
UDAR_DAILY_RESET=true

# Optional. Leave empty if the tablet has an active session and only one active work line at this station.
# If multiple active jobs exist on the station, set UDAR_LINE_ID from the work order line id or map it in CRM.
UDAR_LINE_ID=
UDAR_STATION_CODE=
UDAR_OPERATOR_ID=

UDAR_NOTE=GPIO27 physical pin 13 pulse
UDAR_HTTP_TIMEOUT=5
UDAR_QUEUE_DB=/var/lib/udar-pi-agent/machine_events.sqlite3

# Gonderilemeyen kayit icin bekleme. Kayit kuyrukta ertelenir, arkasindakiler
# beklemeden gonderilir. Gecici hatada 5 sn'den baslayip katlanir; sunucu
# "gecersiz kayit" derse (400/403/404/409/422) 60 sn'den baslar; ust sinir 300 sn.
UDAR_SEND_RETRY_BASE_SECONDS=5
UDAR_SEND_RETRY_VALIDATION_SECONDS=60
UDAR_SEND_RETRY_MAX_SECONDS=300
